# Copy this file to .env and fill in values. Never commit the real .env.

# Optional: enables Claude-written analyst commentary in the report.
# Without it, the report still generates in full, using templated notes instead.
ANTHROPIC_API_KEY=

# Used from Phase 2 onward (EPO Open Patent Services -- free developer account
# at https://developers.epo.org). Not required for Phase 1 (GtR only).
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# Used from Phase 3 onward (Companies House API -- free key at
# https://developer.company-information.service.gov.uk/). Not required yet.
COMPANIES_HOUSE_API_KEY=
